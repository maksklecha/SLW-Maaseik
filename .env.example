# Copy this file to ".env" and fill in your own key:
#   cp .env.example .env
# The .env file is in .gitignore, so it will never be pushed to GitHub.

ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

# Which model to use, written as "provider:model-name".
# Examples: anthropic:claude-sonnet-5-5   openai:gpt-4o-mini
MODEL=anthropic:claude-sonnet-5-5
