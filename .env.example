# Copy this file to ".env" and fill in your own key:
#   cp .env.example .env
# The .env file is in .gitignore, so it will never be pushed to GitHub.
# Without a key the app still works (keyword classifier + template texts).

# Google Gemini (free): get a key at https://aistudio.google.com -> "Get API key"
GOOGLE_API_KEY=

# "provider:model-name". Check the exact Gemini model name in AI Studio.
MODEL=google_genai:gemini-3.1-flash-lite

# LangSmith tracing is forced off in agents.py, so no prompts or data leave the app except to the LLM.
